<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automático e transferência entre aparelhos (Android 12+): somente os dados do app salvos no WebView.
     Vídeos salvos, cache e preferências de lembretes ficam de fora. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage" />
    </device-transfer>
</data-extraction-rules>
